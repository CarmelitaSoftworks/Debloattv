<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="24dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="32sp" />

        <TextView
            style="@style/Body"
            android:text="@string/subtitle" />

        <!-- Conexión -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/steps_title" />

            <TextView
                android:id="@+id/steps"
                style="@style/Body"
                android:text="@string/steps" />

            <EditText
                android:id="@+id/ip"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/input"
                android:digits="0123456789.:"
                android:hint="@string/tv_ip"
                android:importantForAutofill="no"
                android:inputType="number|numberDecimal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/search"
                    style="@style/SecondaryButton"
                    android:layout_marginEnd="8dp"
                    android:text="@string/search" />

                <Button
                    android:id="@+id/connect"
                    style="@style/PrimaryButton"
                    android:text="@string/connect" />
            </LinearLayout>

            <TextView
                android:id="@+id/status"
                style="@style/Body"
                android:layout_marginTop="12dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Todo lo que necesita conexión -->
        <LinearLayout
            android:id="@+id/connected_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/debloat_title" />

                <RadioGroup
                    android:id="@+id/levels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/level_seguro"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/level_seguro"
                        android:textColor="@color/text_primary" />

                    <RadioButton
                        android:id="@+id/level_recomendado"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:checked="true"
                        android:text="@string/level_recomendado"
                        android:textColor="@color/text_primary" />

                    <RadioButton
                        android:id="@+id/level_agresivo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:text="@string/level_agresivo"
                        android:textColor="@color/text_primary" />
                </RadioGroup>

                <TextView
                    android:id="@+id/level_desc"
                    style="@style/Body"
                    android:text="@string/level_recomendado_desc" />

                <LinearLayout
                    android:id="@+id/packages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <Button
                        android:id="@+id/remove"
                        style="@style/PrimaryButton"
                        android:text="@string/remove_selected" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/launcher_title" />

                <TextView
                    style="@style/Body"
                    android:text="@string/launcher_desc" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <Button
                        android:id="@+id/restore_launcher"
                        style="@style/SecondaryButton"
                        android:layout_marginEnd="8dp"
                        android:text="@string/restore_launcher" />

                    <Button
                        android:id="@+id/install_halo"
                        style="@style/PrimaryButton"
                        android:text="@string/install_halo" />
                </LinearLayout>

                <TextView
                    style="@style/Body"
                    android:layout_marginTop="16dp"
                    android:text="@string/ltv_desc" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/install_ltv"
                        style="@style/SecondaryButton"
                        android:text="@string/install_ltv" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/restore_title" />

                <TextView
                    style="@style/Body"
                    android:text="@string/restore_desc" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <Button
                        android:id="@+id/restore_all"
                        style="@style/SecondaryButton"
                        android:text="@string/restore_all" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/log_card"
            style="@style/Card"
            android:visibility="gone">

            <TextView
                style="@style/CardTitle"
                android:text="@string/log_title" />

            <TextView
                android:id="@+id/log"
                style="@style/Body"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
