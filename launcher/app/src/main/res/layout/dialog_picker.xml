<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/picker_title"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/picker_desc"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/choice_halo"
            style="@style/ChoiceCard"
            android:layout_marginEnd="16dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ring"
                android:tint="@color/choice_title" />

            <TextView
                style="@style/ChoiceTitle"
                android:text="@string/app_name" />

            <TextView
                style="@style/ChoiceMeta"
                android:text="@string/picker_halo_meta" />

            <TextView
                style="@style/ChoiceBody"
                android:text="@string/picker_halo_desc" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/choice_ltv"
            style="@style/ChoiceCard">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ring"
                android:tint="@color/status_ok" />

            <TextView
                style="@style/ChoiceTitle"
                android:text="@string/ltv_name" />

            <TextView
                style="@style/ChoiceMeta"
                android:text="@string/picker_ltv_meta" />

            <TextView
                style="@style/ChoiceBody"
                android:text="@string/picker_ltv_desc" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
