<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingStart="@dimen/side_padding"
    android:paddingTop="40dp"
    android:paddingEnd="@dimen/side_padding"
    android:paddingBottom="32dp">

    <!-- Columna izquierda: estado y acciones -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.42"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="0dp"
            android:paddingEnd="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/clean_title"
                android:textColor="@color/text_primary"
                android:textSize="36sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/clean_connecting"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/levels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <RadioButton
                    android:id="@+id/level_seguro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:background="@drawable/focus_row"
                    android:text="@string/level_seguro"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/level_recomendado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:background="@drawable/focus_row"
                    android:checked="true"
                    android:text="@string/level_recomendado"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/level_agresivo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:background="@drawable/focus_row"
                    android:text="@string/level_agresivo"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <Button
                android:id="@+id/remove"
                style="@style/TvButton"
                android:text="@string/clean_remove"
                android:visibility="gone" />

            <Button
                android:id="@+id/set_home"
                style="@style/TvButton"
                android:text="@string/clean_set_home"
                android:visibility="gone" />

            <Button
                android:id="@+id/home_button"
                style="@style/TvButton"
                android:text="@string/opt_home_button"
                android:visibility="gone" />

            <Button
                android:id="@+id/retry"
                style="@style/TvButton"
                android:text="@string/clean_retry"
                android:visibility="gone" />

            <Button
                android:id="@+id/restore_launcher"
                style="@style/TvButton"
                android:text="@string/clean_restore_launcher"
                android:visibility="gone" />

            <Button
                android:id="@+id/restore_all"
                style="@style/TvButton"
                android:text="@string/clean_restore_all"
                android:visibility="gone" />

            <TextView
                android:id="@+id/help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/clean_manual_help"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Columna derecha: apps encontradas -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.58"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/packages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
