<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de la lista y opciones de nivel con el aspecto del teléfono; el foco se marca para el mando -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#FF2C2C34" /><stroke android:width="2dp" android:color="#FFF5F5F7" /><corners android:radius="12dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#00000000" /><corners android:radius="12dp" /></shape>
    </item>
</selector>
