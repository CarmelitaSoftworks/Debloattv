<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="#FF2A2A30" /><corners android:radius="12dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#FF2C2C34" /><corners android:radius="12dp" /><stroke android:width="2dp" android:color="#55FFFFFF" /></shape>
    </item>
    <item>
        <shape><solid android:color="#FF2C2C34" /><corners android:radius="12dp" /></shape>
    </item>
</selector>
