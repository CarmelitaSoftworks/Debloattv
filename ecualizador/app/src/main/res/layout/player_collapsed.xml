<?xml version="1.0" encoding="utf-8"?>
<!-- Reproductor plegado: la pantalla del skin y anterior, reproducir/pausa y siguiente con sus botones. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/player_display_image"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:contentDescription="@string/now_playing_name"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/player_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />

    <ImageView android:id="@+id/player_previous_small" android:layout_width="40dp" android:layout_height="32dp" android:scaleType="fitCenter" android:contentDescription="@string/player_previous" />
    <ImageView android:id="@+id/player_toggle_small" android:layout_width="40dp" android:layout_height="32dp" android:scaleType="fitCenter" android:contentDescription="@string/player_toggle" />
    <ImageView android:id="@+id/player_next_small" android:layout_width="40dp" android:layout_height="32dp" android:scaleType="fitCenter" android:contentDescription="@string/player_next" />
</LinearLayout>
